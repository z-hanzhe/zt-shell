{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZTShell",
  "version": "0.2.8",
  "identifier": "site.hanzhe.zt-shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZTShell",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NjdFMjk5RTAyNERDRTcKUldUbjNDVGdtZUpuS0wrd2xRazVrSy94R0lrR2VWNGdlSzdoWmlENEt5Zm1LVFFjNS9mdGI1cEoK",
      "endpoints": ["https://github.com/z-hanzhe/zt-shell/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
